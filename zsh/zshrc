# ~/.zshrc -> personal-config/zsh/zshrc (symlink made by install.sh)
#
# Load order: env -> path -> oh-my-zsh -> aliases -> functions -> tools -> ~/.zshrc.local
# Machine-specific settings and secrets (API keys, tokens) go in ~/.zshrc.local.
# That file is never committed. ZSH_THEME / DSA_HOME overrides that must exist before
# oh-my-zsh loads go in ~/.zshenv (zsh reads it first).

# Repo root, resolved through the ~/.zshrc symlink
export PERSONAL_CONFIG="${PERSONAL_CONFIG:-${${(%):-%x}:A:h:h}}"
ZDOT="$PERSONAL_CONFIG/zsh"

source "$ZDOT/env.zsh"
source "$ZDOT/path.zsh"

# ---- oh-my-zsh ---------------------------------------------------------------
export ZSH="${ZSH:-$HOME/.oh-my-zsh}"
if [[ -r "$ZSH/oh-my-zsh.sh" ]]; then
  ZSH_THEME="${ZSH_THEME:-agnoster}"      # needs a Powerline / Nerd Font in the terminal
  DEFAULT_USER="$USER"                    # agnoster: hide user@host on your own machine
  plugins=(git)
  # optional plugins: enabled only when installed (install.sh clones them)
  for p in zsh-autosuggestions zsh-syntax-highlighting; do
    [[ -d "${ZSH_CUSTOM:-$ZSH/custom}/plugins/$p" ]] && plugins+=("$p")
  done
  source "$ZSH/oh-my-zsh.sh"
else
  autoload -Uz compinit && compinit
  PROMPT='%F{cyan}%~%f %# '
fi

source "$ZDOT/aliases.zsh"
source "$ZDOT/functions.zsh"
source "$ZDOT/tools.zsh"

[[ -r "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"
